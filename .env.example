TINYCLASS_DB_NAME=tinyclass
TINYCLASS_DB_USER=tinyclass
TINYCLASS_DB_PASSWORD=replace-with-a-random-local-password
TINYCLASS_DB_PORT=55432
TINYCLASS_TEST_DB_PASSWORD=replace-with-a-different-random-test-password
TINYCLASS_TEST_DB_PORT=55433

# Required only for creating the first teacher. Generate with Initialize-LocalEnvironment.ps1.
TINYCLASS_SETUP_KEY=

# Local email capture. Real delivery is configured separately for production.
TINYCLASS_PUBLIC_URL=http://localhost:5173
TINYCLASS_MAIL_ENABLED=true
TINYCLASS_MAIL_PORT=11025
TINYCLASS_MAIL_UI_PORT=18025

# Google login is optional. Configure a Web application OAuth client before enabling.
# Never commit a real client secret. Drive authorization is configured separately.
TINYCLASS_GOOGLE_LOGIN_ENABLED=false
TINYCLASS_GOOGLE_CLIENT_ID=
TINYCLASS_GOOGLE_CLIENT_SECRET=

# Private media directory, outside static/build/Git. Back it up with the database.
TINYCLASS_UPLOAD_ROOT=../.local/uploads
TINYCLASS_STORAGE_QUOTA_BYTES=5368709120
